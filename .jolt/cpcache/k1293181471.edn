{:material "1390:{:paths [\"src\"]\n\n ;; orchard resolves var/namespace metadata and clojuredocs entries; compliment\n ;; does completion. Both run on jolt as published, and cider-nrepl uses the same\n ;; two, so the ops answer with the data an editor already knows how to read.\n ;; spec.alpha is orchard's (it reports a var's spec alongside its docstring).\n :deps {cider/orchard {:mvn/version \"0.44.0\"}\n        compliment/compliment {:mvn/version \"0.8.0\"}\n        org.clojure/spec.alpha {:mvn/version \"0.5.238\"}}\n\n ;; The client transport and the session worker bind libc (sockets + the process\n ;; symbols) through jolt.ffi; declared :process so jolt loads them before the\n ;; namespaces are required.\n :jolt/native [{:name \"libc (POSIX sockets)\" :process true}]\n\n ;; This library's server middleware — jolt.nrepl composes them over its built-in\n ;; handler. A consuming project adds this lib and copies this line; declared here\n ;; so `jolt nrepl-server` in this repo serves the full stack.\n ;;   nrepl.middleware/default-middleware  sessions, interruptible eval, completion, lookup\n ;;   cider.nrepl/cider-middleware         the cider-nrepl ops (info, complete, test, …)\n :nrepl/middleware [nrepl.middleware/default-middleware\n                    cider.nrepl/cider-middleware]\n\n :aliases {:test {:extra-paths [\"test\"]\n                  :main-opts [\"-m\" \"nrepl.test-runner\"]}}\n\n :tasks {test \"jolt -M:test\"}}\n|679:{:aliases {;; Add cross-project aliases here\n           :outdated {;; Note that it is `:deps`, not `:extra-deps`\n                      :deps {com.github.liquidz/antq {:mvn/version \"2.5.1109\"}}\n                      :main-opts [\"-m\" \"antq.core\"]}\n           :mcp\n           {:deps {org.slf4j/slf4j-nop {:mvn/version \"2.0.16\"} ;; Required for stdio server\n                   com.bhauman/clojure-mcp {:git/url \"https://github.com/bhauman/clojure-mcp.git\"\n                                            :git/tag \"v0.1.6-alpha\"\n                                            :git/sha \"4ad62f4\"}}\n            :exec-fn clojure-mcp.main/start-mcp-server\n            :exec-args {:port 7888}}}}\n|[]|v0.7.10-7-gb7dd586e|/Users/yogthos/.jolt/gitlibs||/Users/yogthos|", :value {:roots ["/Users/yogthos/.m2/repository/cider/orchard/0.44.0/orchard-0.44.0.jar.jolt" "/Users/yogthos/.m2/repository/compliment/compliment/0.8.0/compliment-0.8.0.jar.jolt" "/Users/yogthos/.m2/repository/org/clojure/spec.alpha/0.5.238/spec.alpha-0.5.238.jar.jolt"], :natives [], :prep [], :libs {cider/orchard #:mvn{:version "0.44.0"}, compliment/compliment #:mvn{:version "0.8.0"}, org.clojure/spec.alpha #:mvn{:version "0.5.238"}}, :trace nil}}